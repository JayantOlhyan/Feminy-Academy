# Site Environment & Canonical URL
# NEXT_PUBLIC_SITE_ENV: "staging" | "production" (Default: "staging" when unset)
# Staging enforces noindex, nofollow, disallow all in robots.txt, no canonical, and empty sitemap.
NEXT_PUBLIC_SITE_ENV="staging"

# Canonical Site URL (Default: "https://feminy-academy.netlify.app")
# TODO(domain): decide myfeminy.com vs feminyacademy.com
NEXT_PUBLIC_SITE_URL="https://feminy-academy.netlify.app"

# Database (MongoDB Atlas for leads & whatsapp_clicks)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/feminy_academy?retryWrites=true&w=majority"

# Google Sheet Webhook (Apps Script Web App URL — see scripts/sheet-webhook.gs)
SHEET_WEBHOOK_URL="https://script.google.com/macros/s/AKfycb.../exec"

# Client-Side Analytics (Meta Pixel & GA4)
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GA4_ID=""

# Meta Conversions API (Server-side Graph API v22.0)
META_CAPI_TOKEN=""
META_TEST_EVENT_CODE=""
